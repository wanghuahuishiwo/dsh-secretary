{
  "name": "dsh-secretary-dispatch-messaging",
  "version": "0.1.0",
  "description": "Dispatch foundation messaging: NKey connection to the Gateway, CloudEvents 1.0.2 envelope with the DSH profile, node identity file, and online JetStream stream/consumer creation.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./contract": {
      "types": "./lib/types/contract.d.ts",
      "default": "./lib/contract.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && node build.mjs",
    "prepare": "node build.mjs",
    "test": "node --test tests/*.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.1",
    "@nats-io/jetstream": "3.5.0",
    "@nats-io/nats-core": "3.5.0",
    "@nats-io/transport-node": "3.5.0",
    "dsh-secretary-dispatch-gateway": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-credentials": ">=0.2.2-rc.1 <0.3.0",
    "esbuild": "^0.25.10",
    "typescript": "^6.0.3"
  }
}
