{
  "name": "dsh-secretary",
  "version": "0.1.0",
  "description": "Personal Secretary Agent for DSH: a Markdown GTD data plane, CLI time/tag ops, and proactive follow-through.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "assets"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "prepare": "node build.mjs",
    "test": "node --test tests/tracer.mjs tests/gateway.mjs tests/messaging.mjs && node --test tests/browser.mjs",
    "test:browser": "node --test tests/browser.mjs",
    "test:installed": "node --test tests/installed.mjs",
    "test:tracer": "node --test tests/tracer.mjs tests/gateway.mjs tests/messaging.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-storage-sqlite": "0.2.2-rc.1",
    "dsh-secretary-cli": "workspace:*",
    "dsh-secretary-dispatch-controller": "workspace:*",
    "dsh-secretary-goal-provider": "workspace:*",
    "dsh-secretary-gtd-agent": "workspace:*",
    "dsh-secretary-skill-resources": "workspace:*",
    "dsh-secretary-storage-domain": "workspace:*",
    "dsh-secretary-tag-service": "workspace:*",
    "dsh-secretary-time-block": "workspace:*",
    "dsh-secretary-time-controller": "workspace:*",
    "dsh-secretary-ui-dispatch-console": "workspace:*",
    "dsh-secretary-ui-gtd": "workspace:*",
    "dsh-secretary-ui-time": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-storage": "0.2.2-rc.1",
    "@nats-io/jetstream": "3.5.0",
    "@nats-io/services": "3.5.0",
    "dsh-secretary-dispatch-engine": "workspace:*",
    "dsh-secretary-dispatch-gateway": "workspace:*",
    "dsh-secretary-dispatch-messaging": "workspace:*",
    "esbuild": "^0.25.10",
    "playwright": "1.62.1"
  }
}
