{
  "name": "dsh-secretary-time-controller",
  "version": "0.1.0",
  "description": "Time product Host API: six product-local Typert Remote methods over TimeService and TagService.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "dependencies": {
    "dsh-secretary-tag": "workspace:*",
    "dsh-secretary-time-block": "workspace:*",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.1-rc.5 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.1-rc.5 <0.3.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.10",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "tsc -b tsconfig.host.json && node build.mjs",
    "dev": "node build.mjs --watch",
    "prepare": "node ../../../scripts/generate-typert.mjs && node build.mjs",
    "test": "node --test tests/*.mjs"
  }
}
