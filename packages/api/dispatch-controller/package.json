{
  "name": "dsh-secretary-dispatch-controller",
  "version": "0.1.0",
  "description": "Dispatch foundation Host API: Gateway settings, status and start/stop/restart over the Typert Remote `secretaryDispatch`; NKey seeds are kept in DSH-managed credentials.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "dependencies": {
    "@nats-io/jetstream": "3.5.0",
    "@nats-io/nats-core": "3.5.0",
    "@nats-io/services": "3.5.0",
    "@nats-io/transport-node": "3.5.0",
    "dsh-secretary-dispatch-gateway": "workspace:*",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-credentials": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.2-rc.1 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.2-rc.1 <0.3.0",
    "@types/node": "^24.0.0",
    "dsh-secretary-dispatch-engine": "workspace:*",
    "dsh-secretary-dispatch-messaging": "workspace:*",
    "esbuild": "^0.25.10",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "tsc -b tsconfig.host.json && node build.mjs",
    "dev": "node build.mjs --watch",
    "prepare": "node ../../../scripts/generate-typert.mjs && node build.mjs",
    "test": "node --test tests/*.mjs"
  }
}
